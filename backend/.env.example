# Local default is SQLite; on Render this is set from the Postgres database automatically.
DATABASE_URL=sqlite:///./invoice_ai.db
# --- AI (OpenAI, optional) -----------------------------------------------------------------
# Enables AI extraction, description-meaning scoring, the AI summary and the AI review recommendation.
# Leave OPENAI_API_KEY empty to run rules-only. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Reads the invoice PDF and, unless OPENAI_FAST_MODEL is set, does every other AI task too
OPENAI_MODEL=gpt-6-luna
# Optional: a separate model for the short tasks (summary, recommendation); empty = OPENAI_MODEL
OPENAI_FAST_MODEL=
# Optional: model to try when the first one is overloaded / times out
OPENAI_FALLBACK_MODEL=
# auto (low for most calls) | none | minimal | low | medium | high | default
OPENAI_REASONING=auto
# How PDF pages are rendered for the model: auto | low (fewer tokens) | high
OPENAI_PDF_DETAIL=auto
# auto: skip the AI reader for clean digital invoices whose totals all reconcile; always: every invoice
AI_EXTRACTION=auto
# Seconds before an AI call is abandoned and the invoice continues rules-only
LLM_TIMEOUT_SECONDS=60

# Single hard-coded reviewer - CHANGE these in production
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=review123
REVIEWER_DISPLAY_NAME=AP Reviewer
# Manager account: the only one that may approve invoices above the auto-approval limit
# and change vendor bank details. Leave MANAGER_PASSWORD empty to disable it.
MANAGER_USERNAME=manager
MANAGER_PASSWORD=manage123
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true

# Optional e-mail intake (IMAP). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# Guest mode: "Continue as guest" on the sign-in page gives every visitor a private sandbox
# (own copy of the demo vendors/POs; uploads and settings are invisible to everyone else).
GUEST_MODE=true
GUEST_TTL_HOURS=24          # a sandbox unused this long is deleted
GUEST_MAX_WORKSPACES=100    # sandboxes alive at once
GUEST_PER_IP_PER_HOUR=5     # new sandboxes per client per hour
GUEST_MAX_INVOICES=150      # uploads per sandbox (each may call the AI)

# Production hardening
ALLOW_DEMO_RESET=true
