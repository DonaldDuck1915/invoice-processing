# Local default is SQLite; on Render this is set from the Postgres database automatically.
DATABASE_URL=sqlite:///./invoice_ai.db
# --- AI (optional) -------------------------------------------------------------------------
# Enables AI extraction, description-meaning scoring, the AI summary and the AI review recommendation.
# With no key the app runs rules-only. Set ONE of these keys (if both are set, Gemini is used unless
# LLM_PROVIDER says otherwise). Get a Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Reads the invoice PDF (accuracy matters most). Model ids as shown in Google AI Studio.
GEMINI_MODEL=gemini-3.6-flash
# Short tasks: summary + recommendation, description meaning (cheaper / faster). Empty = use GEMINI_MODEL.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# auto (low for most calls) | low | medium | high | default (the model's own setting)
GEMINI_THINKING=auto
# Seconds before an AI call is abandoned and the invoice continues rules-only
LLM_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# auto | gemini | anthropic
LLM_PROVIDER=auto

# Single hard-coded reviewer - CHANGE these in production
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=review123
REVIEWER_DISPLAY_NAME=AP Reviewer
AUTH_SECRET=change-me-to-a-long-random-string
# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true

# Optional e-mail intake (IMAP). Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=60

# Production hardening
ALLOW_DEMO_RESET=true
